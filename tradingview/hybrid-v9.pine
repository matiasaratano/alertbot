//@version=6
indicator("RSI + Momentum · Híbrido v9", overlay=false, max_lines_count=400, max_labels_count=300)

// BUY/SELL conservan los cruces del script simple suministrado (titulado v3).
// Se publican al cierre: no esperan divergencias, EMA ni ruptura del precio.
// Las líneas de divergencia unen pivotes PASADOS; la etiqueta marca el cierre
// en que se conoció la divergencia. No son entradas en la vela del pivote.
// Solo divergencias regulares entre pivotes consecutivos de cada serie.
// Indicador visual, no estrategia ni backtest. No envía órdenes.

string G_RSI = "1 · Señales RSI originales"
string G_MOM = "2 · Momentum y squeeze"
string G_DIV = "3 · Divergencias confirmadas"
string G_VIS = "4 · Contexto visual"
string G_ALT = "5 · Alertas agrupadas"

int rsiLen = input.int(14, "Período RSI", minval=2, group=G_RSI)
float buyLevel = input.float(30, "BUY: cruce hacia arriba", minval=1, maxval=49, group=G_RSI)
float sellLevel = input.float(70, "SELL: cruce hacia abajo", minval=51, maxval=99, group=G_RSI)
bool showSignals = input.bool(true, "Mostrar BUY / SELL", group=G_RSI)

int bbLen = input.int(20, "BB Length", minval=2, group=G_MOM)
float bbMult = input.float(2.0, "BB Mult", minval=0.1, step=0.1, group=G_MOM)
int kcLen = input.int(20, "KC Length", minval=2, group=G_MOM)
float kcMult = input.float(1.5, "KC Mult", minval=0.1, step=0.1, group=G_MOM)
bool showTurns = input.bool(false, "Marcar giros del histograma (no BUY/SELL)", group=G_MOM)

int pivotLen = input.int(5, "Velas a cada lado del pivote", minval=1, maxval=20, group=G_DIV,
     tooltip="Con 5, la divergencia se conoce 5 velas después del segundo extremo. Menos velas reduce la demora y cambia qué extremos se detectan.")
int minRange = input.int(5, "Mínimo de velas entre pivotes", minval=1, maxval=500, group=G_DIV)
int maxRange = input.int(60, "Máximo de velas entre pivotes", minval=2, maxval=500, group=G_DIV)
bool showMomDiv = input.bool(true, "Divergencias MOM en panel", group=G_DIV)
bool showRsiDiv = input.bool(true, "Divergencias RSI en precio y panel RSI", group=G_DIV)
bool momOnPrice = input.bool(false, "También líneas MOM sobre precio", group=G_DIV)
bool sameSide = input.bool(true, "MOM: ambos valles negativos / picos positivos", group=G_DIV,
     tooltip="Activado reproduce el filtro del v8. Desactivado permite divergencias MOM entre extremos de distinto signo, como el script simple.")

string panelMode = input.string("Momentum", "Panel inferior", options=["Momentum", "RSI"], group=G_VIS)
bool showEma = input.bool(true, "Mostrar EMA de contexto", group=G_VIS)
int emaLen = input.int(200, "Período EMA", minval=2, group=G_VIS)
bool showSwings = input.bool(false, "Últimos máximo / mínimo confirmados", group=G_VIS,
     tooltip="Referencias de estructura, no stops recomendados. Se actualizan al confirmar un pivote del precio.")
bool showContext = input.bool(true, "Mostrar tabla compacta (último cierre)", group=G_VIS)
int atrLen = input.int(14, "ATR de contexto", minval=1, group=G_VIS)

bool notifyRsi = input.bool(true, "Incluir BUY/SELL", group=G_ALT)
bool notifyDiv = input.bool(true, "Incluir divergencias", group=G_ALT)
bool notifyRelease = input.bool(false, "Incluir salida de compresión", group=G_ALT,
     tooltip="Estos controles afectan a 'Any alert() function call'. Las alertas individuales se eligen directamente por nombre.")

if barstate.isfirst and minRange > maxRange
    runtime.error("El mínimo entre pivotes no puede superar el máximo.")

float rsi = ta.rsi(close, rsiLen)
bool crossUp = ta.crossover(rsi, buyLevel)
bool crossDown = ta.crossunder(rsi, sellLevel)
bool buySignal = barstate.isconfirmed and crossUp
bool sellSignal = barstate.isconfirmed and crossDown

float bbBasis = ta.sma(close, bbLen)
float bbDev = bbMult * ta.stdev(close, bbLen)
float kcBasis = ta.sma(close, kcLen)
float kcRange = ta.sma(ta.tr, kcLen)
bool sqzOn = bbBasis - bbDev > kcBasis - kcRange * kcMult and bbBasis + bbDev < kcBasis + kcRange * kcMult
bool sqzOff = bbBasis - bbDev < kcBasis - kcRange * kcMult and bbBasis + bbDev > kcBasis + kcRange * kcMult
float meanKC = math.avg(math.avg(ta.highest(high, kcLen), ta.lowest(low, kcLen)), ta.sma(close, kcLen))
float mom = ta.linreg(close - meanKC, kcLen, 0)
bool momRising = mom > mom[1]
bool momFalling = mom < mom[1]
bool release = barstate.isconfirmed and sqzOn[1] and not sqzOn
bool bullTurn = barstate.isconfirmed and mom < 0 and momRising and mom[1] <= mom[2]
bool bearTurn = barstate.isconfirmed and mom > 0 and momFalling and mom[1] >= mom[2]
float ema = ta.ema(close, emaLen)
float atr = ta.atr(atrLen)
bool rsiPanel = panelMode == "RSI"
color histColor = mom > 0 ? (momRising ? color.lime : color.green) : (momFalling ? color.red : color.maroon)
color squeezeColor = sqzOn ? color.orange : sqzOff ? color.aqua : color.gray

plot(rsiPanel ? na : mom, "Momentum", color=histColor, style=plot.style_histogram, linewidth=4)
plot(rsiPanel ? na : 0, "Squeeze: naranja comprimido / celeste fuera / gris transición", color=squeezeColor, style=plot.style_cross, linewidth=2)
plot(rsiPanel ? rsi : na, "RSI", color=color.purple, linewidth=2)
plot(rsiPanel ? buyLevel : na, "Sobreventa", color=color.new(color.lime, 45))
plot(rsiPanel ? sellLevel : na, "Sobrecompra", color=color.new(color.red, 45))
plot(rsiPanel ? 50 : 0, "Referencia central", color=color.new(color.gray, 65))
plot(showEma ? ema : na, "EMA de contexto", color=color.orange, linewidth=2, force_overlay=true)
plotshape(showSignals and buySignal, title="BUY RSI", style=shape.triangleup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.small, force_overlay=true)
plotshape(showSignals and sellSignal, title="SELL RSI", style=shape.triangledown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.small, force_overlay=true)
plotshape(showTurns and not rsiPanel and bullTurn ? mom : na, title="Giro MOM ascendente", style=shape.circle, location=location.absolute, color=color.aqua, size=size.tiny)
plotshape(showTurns and not rsiPanel and bearTurn ? mom : na, title="Giro MOM descendente", style=shape.circle, location=location.absolute, color=color.orange, size=size.tiny)

// MOM: pivotes del oscilador y high/low de esas velas, como en v8.
// RSI: pivotes del precio y RSI de esas velas, como en v8.
// No exigimos que los pivotes MOM sean también pivotes independientes del precio.
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float mh = ta.pivothigh(mom, pivotLen, pivotLen)
float ml = ta.pivotlow(mom, pivotLen, pivotLen)
int pivotBar = bar_index - pivotLen

var float last_momBear_osc = na
var float last_momBear_price = na
var int last_momBear_bar = na
bool momBear = false
if barstate.isconfirmed and not na(mh)
    int gap = pivotBar - last_momBear_bar
    momBear := not na(last_momBear_osc) and high[pivotLen] > last_momBear_price and mh < last_momBear_osc and gap >= minRange and gap <= maxRange and (not sameSide or (last_momBear_osc > 0 and mh > 0))
    if momBear and showMomDiv
        if not rsiPanel
            line.new(last_momBear_bar, last_momBear_osc, pivotBar, mh, color=color.red, width=2)
        if momOnPrice
            line.new(last_momBear_bar, last_momBear_price, pivotBar, high[pivotLen], color=color.red, width=2, style=line.style_dashed, force_overlay=true)
    last_momBear_osc := mh
    last_momBear_price := high[pivotLen]
    last_momBear_bar := pivotBar

var float last_momBull_osc = na
var float last_momBull_price = na
var int last_momBull_bar = na
bool momBull = false
if barstate.isconfirmed and not na(ml)
    int gap = pivotBar - last_momBull_bar
    momBull := not na(last_momBull_osc) and low[pivotLen] < last_momBull_price and ml > last_momBull_osc and gap >= minRange and gap <= maxRange and (not sameSide or (last_momBull_osc < 0 and ml < 0))
    if momBull and showMomDiv
        if not rsiPanel
            line.new(last_momBull_bar, last_momBull_osc, pivotBar, ml, color=color.lime, width=2)
        if momOnPrice
            line.new(last_momBull_bar, last_momBull_price, pivotBar, low[pivotLen], color=color.lime, width=2, style=line.style_dashed, force_overlay=true)
    last_momBull_osc := ml
    last_momBull_price := low[pivotLen]
    last_momBull_bar := pivotBar

var float last_rsiBear_osc = na
var float last_rsiBear_price = na
var int last_rsiBear_bar = na
bool rsiBear = false
if barstate.isconfirmed and not na(ph)
    int gap = pivotBar - last_rsiBear_bar
    rsiBear := not na(last_rsiBear_osc) and ph > last_rsiBear_price and rsi[pivotLen] < last_rsiBear_osc and gap >= minRange and gap <= maxRange
    if rsiBear and showRsiDiv
        line.new(last_rsiBear_bar, last_rsiBear_price, pivotBar, ph, color=color.fuchsia, width=2, force_overlay=true)
        if rsiPanel
            line.new(last_rsiBear_bar, last_rsiBear_osc, pivotBar, rsi[pivotLen], color=color.fuchsia, width=2)
    last_rsiBear_osc := rsi[pivotLen]
    last_rsiBear_price := ph
    last_rsiBear_bar := pivotBar

var float last_rsiBull_osc = na
var float last_rsiBull_price = na
var int last_rsiBull_bar = na
bool rsiBull = false
if barstate.isconfirmed and not na(pl)
    int gap = pivotBar - last_rsiBull_bar
    rsiBull := not na(last_rsiBull_osc) and pl < last_rsiBull_price and rsi[pivotLen] > last_rsiBull_osc and gap >= minRange and gap <= maxRange
    if rsiBull and showRsiDiv
        line.new(last_rsiBull_bar, last_rsiBull_price, pivotBar, pl, color=color.aqua, width=2, force_overlay=true)
        if rsiPanel
            line.new(last_rsiBull_bar, last_rsiBull_osc, pivotBar, rsi[pivotLen], color=color.aqua, width=2)
    last_rsiBull_osc := rsi[pivotLen]
    last_rsiBull_price := pl
    last_rsiBull_bar := pivotBar

// Una etiqueta por dirección y cierre; evita duplicar RSI + MOM.
string bullText = (showRsiDiv and rsiBull ? "RSI" : "") + (showMomDiv and momBull ? (showRsiDiv and rsiBull ? "+MOM" : "MOM") : "")
string bearText = (showRsiDiv and rsiBear ? "RSI" : "") + (showMomDiv and momBear ? (showRsiDiv and rsiBear ? "+MOM" : "MOM") : "")
string divTip = "Divergencia regular confirmada en ESTA vela. Segundo pivote: " + str.tostring(pivotLen) + " velas atrás. Las líneas se dibujan retrospectivamente entre los extremos. No garantiza reversión."
float labelGap = nz(atr, high - low) * 0.8
if str.length(bullText) > 0
    label.new(bar_index, low - labelGap, bullText + " ↑", style=label.style_label_up, color=color.new(color.teal, 15), textcolor=color.white, size=size.tiny, tooltip=divTip, force_overlay=true)
if str.length(bearText) > 0
    label.new(bar_index, high + labelGap, bearText + " ↓", style=label.style_label_down, color=color.new(color.purple, 15), textcolor=color.white, size=size.tiny, tooltip=divTip, force_overlay=true)

var float swingHigh = na
var float swingLow = na
if barstate.isconfirmed
    if not na(ph)
        swingHigh := ph
    if not na(pl)
        swingLow := pl
plot(showSwings ? swingHigh : na, "Último máximo confirmado", color=color.new(color.red, 50), style=plot.style_stepline, force_overlay=true)
plot(showSwings ? swingLow : na, "Último mínimo confirmado", color=color.new(color.teal, 50), style=plot.style_stepline, force_overlay=true)

// Tabla congelada al último cierre; el histograma y RSI sí fluctúan intravela.
int ix = barstate.isconfirmed ? 0 : 1
float ctxRsi = rsi[ix]
float ctxMom = mom[ix]
float ctxPrevMom = mom[ix + 1]
float ctxClose = close[ix]
float ctxEma = ema[ix]
float atrPct = ctxClose != 0 ? atr[ix] / ctxClose * 100 : na
string momText = na(ctxMom) or na(ctxPrevMom) ? "Sin datos" : (ctxMom >= 0 ? "Positivo" : "Negativo") + (ctxMom > ctxPrevMom ? " / sube" : ctxMom < ctxPrevMom ? " / baja" : " / plano")
string emaText = na(ctxEma) ? "Sin datos" : ctxClose > ctxEma ? "Precio encima" : ctxClose < ctxEma ? "Precio debajo" : "Precio en EMA"
string sqzText = na(ctxMom) ? "Sin datos" : sqzOn[ix] ? "Comprimido" : sqzOff[ix] ? "Fuera" : "Transición"
var table context = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20))
if barstate.islast and showContext
    table.cell(context, 0, 0, "Último cierre", text_color=color.silver, text_size=size.small)
    table.cell(context, 1, 0, timeframe.period, text_color=color.silver, text_size=size.small)
    table.cell(context, 0, 1, "RSI", text_color=color.white, text_size=size.small)
    table.cell(context, 1, 1, str.tostring(ctxRsi, "#.0"), text_color=ctxRsi < buyLevel ? color.lime : ctxRsi > sellLevel ? color.red : color.white, text_size=size.small)
    table.cell(context, 0, 2, "MOM", text_color=color.white, text_size=size.small)
    table.cell(context, 1, 2, momText, text_color=ctxMom > ctxPrevMom ? color.lime : color.orange, text_size=size.small)
    table.cell(context, 0, 3, "EMA " + str.tostring(emaLen), text_color=color.white, text_size=size.small)
    table.cell(context, 1, 3, emaText, text_color=ctxClose > ctxEma ? color.lime : color.orange, text_size=size.small)
    table.cell(context, 0, 4, "Squeeze", text_color=color.white, text_size=size.small)
    table.cell(context, 1, 4, sqzText, text_color=sqzOn[ix] ? color.orange : color.aqua, text_size=size.small)
    table.cell(context, 0, 5, "ATR " + str.tostring(atrLen) + " (%)", text_color=color.white, text_size=size.small)
    table.cell(context, 1, 5, str.tostring(atrPct, "#.00") + "%", text_color=color.white, text_size=size.small)

// Alertas individuales: independientes de las opciones de dibujo.
alertcondition(buySignal, "BUY RSI original", "BUY RSI al cierre | {{ticker}} | TF {{interval}} | Precio {{close}}")
alertcondition(sellSignal, "SELL RSI original", "SELL RSI al cierre | {{ticker}} | TF {{interval}} | Precio {{close}}")
alertcondition(rsiBull, "Divergencia RSI alcista", "RSI alcista confirmada AHORA | {{ticker}} | TF {{interval}}")
alertcondition(rsiBear, "Divergencia RSI bajista", "RSI bajista confirmada AHORA | {{ticker}} | TF {{interval}}")
alertcondition(momBull, "Divergencia MOM alcista", "MOM alcista confirmada AHORA | {{ticker}} | TF {{interval}}")
alertcondition(momBear, "Divergencia MOM bajista", "MOM bajista confirmada AHORA | {{ticker}} | TF {{interval}}")
alertcondition(release, "Salida de compresión", "Fin de compresión, sin dirección garantizada | {{ticker}} | TF {{interval}}")

// Crear UNA alerta 'Any alert() function call' para agrupar eventos del cierre.
string events = ""
if notifyRsi and buySignal
    events += "BUY: RSI cruza sobre " + str.tostring(buyLevel) + ".\n"
if notifyRsi and sellSignal
    events += "SELL: RSI cruza bajo " + str.tostring(sellLevel) + ".\n"
if notifyDiv and rsiBull
    events += "Divergencia RSI alcista confirmada.\n"
if notifyDiv and rsiBear
    events += "Divergencia RSI bajista confirmada.\n"
if notifyDiv and momBull
    events += "Divergencia MOM alcista confirmada.\n"
if notifyDiv and momBear
    events += "Divergencia MOM bajista confirmada.\n"
if notifyRelease and release
    events += "Salida de compresión; no define dirección.\n"
if barstate.isconfirmed and str.length(events) > 0
    string details = "Cierre: " + str.tostring(close, format.mintick) + " | RSI: " + str.tostring(rsi, "#.0") + "\nMOM: " + momText + " | " + emaText + " | ATR: " + str.tostring(atrPct, "#.00") + "%"
    alert(syminfo.tickerid + " | TF " + timeframe.period + "\n" + events + details + "\nDivergencias: confirmación " + str.tostring(pivotLen) + " velas después del extremo.", alert.freq_once_per_bar_close)
