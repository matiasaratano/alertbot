+
+// Alertconditions tradicionales
+alertcondition(buySignal and alertRsi, title="BUY (RSI)", message="RSI cruza hacia arriba el nivel de sobreventa")
+alertcondition(sellSignal and alertRsi, title="SELL (RSI)", message="RSI cruza hacia abajo el nivel de sobrecompra")
+alertcondition(momBullDiv and alertDiv, title="Divergencia Alcista (Momentum)", message="Posible divergencia alcista en Momentum")
+alertcondition(momBearDiv and alertDiv, title="Divergencia Bajista (Momentum)", message="Posible divergencia bajista en Momentum")
